<section class="editor-section config-section">
 <h3>蜂窝模块</h3>
 <label class="inline-check"><input aria-label="启用AT自动探测" type="checkbox" checked="@(State.Project.CellularProbe is not null)" disabled="@State.Locked" @onchange="Toggle" />自动识别 AT 端口</label>
 @if(State.Project.CellularProbe is {} settings){
  <fieldset disabled="@State.Locked"><legend>采集内容</legend>
   <label>采集周期（秒）<input aria-label="AT自动探测周期" type="number" min="10" max="86400" @bind="settings.IntervalSeconds" @bind:after="State.Touch" /></label>
   <label class="inline-check"><input aria-label="采集SIM与信号" type="checkbox" @bind="settings.Telemetry" @bind:after="TelemetryChanged" />SIM、驻网与信号</label>
   <label class="inline-check"><input aria-label="蜂窝详细采集" type="checkbox" @bind="settings.Details" @bind:after="DetailsChanged" />小区、载波、温度、连接与锁定详情</label>
  </fieldset>
  @if(State.Publishing.Synchronized&&!State.Publishing.ServerCapabilities.Contains(settings.Details?"cellular_details_v1":settings.Telemetry?"cellular_telemetry_v2":"cellular_identity_v1")){<p class="error-text" role="alert">当前 Server 不支持所选采集内容，请先更新 Server。</p>}
 }
</section>
@code {
 [Parameter,EditorRequired] public EditorWorkspace State {get;set;}=default!;
 private void DetailsChanged(){if(State.Project.CellularProbe is {} c && c.Details)c.Telemetry=true;State.Touch();}
 private void TelemetryChanged(){if(State.Project.CellularProbe is {} c && !c.Telemetry)c.Details=false;State.Touch();}
 private void Toggle(ChangeEventArgs e){if(State.Locked)return;State.Project.CellularProbe=e.Value is true?new CellularSettings():null;State.Touch();}
}
