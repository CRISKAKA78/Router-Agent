@if (State.Selected is not { } row)
{
    <div class="empty-state"><div class="empty-symbol" aria-hidden="true">⌘</div><h2>开始编写探针模板</h2><p>定义采集来源，组合属性与公式，再预览并发布。</p><div class="inline-actions"><FluentButton Appearance="Appearance.Accent" Disabled="@State.Locked" OnClick="@(() => State.AddAttribute(AttributeVisibility.Display))">＋ 新建属性</FluentButton><FluentButton Disabled="@State.Locked" OnClick="@(() => State.LoadExample(false))">加载示例</FluentButton></div></div>
}
else
{
    <div class="editor-page">
        <header class="editor-heading"><div><div class="eyebrow">属性编辑器 <span> / </span> @(row.Visibility == AttributeVisibility.Display ? "展示属性" : "虚拟属性")</div><h2>@(string.IsNullOrWhiteSpace(row.Name) ? "未命名属性" : row.Name)</h2><code>@(string.IsNullOrWhiteSpace(row.Key) ? "填写属性标识以供公式引用" : row.Key)</code></div><div class="inline-actions"><FluentButton Disabled="@(State.Locked || State.Project.Attributes.Count >= 128)" OnClick="@(() => State.CopyAttribute())">复制属性</FluentButton><FluentButton Appearance="Appearance.Stealth" Class="subtle-danger" Disabled="@State.Locked" OnClick="@(() => State.RemoveAttribute())">删除</FluentButton></div></header>
        <fieldset class="attribute-form" disabled="@State.Locked">
            <section class="editor-section">
                <h3>基本信息</h3>
                <div class="field-grid">
                    <label for="attribute-name">属性名称<input id="attribute-name" aria-label="属性名称" @bind="row.Name" @bind:event="oninput" @bind:after="State.Touch" aria-invalid="@(Error("name", row) is not null)" aria-describedby="attribute-name-error" /><FieldError Id="attribute-name-error" Message="@Error("name", row)" /></label>
                    <label for="attribute-key">属性标识<input id="attribute-key" class="code-input" aria-label="属性标识" @bind="row.Key" @bind:event="oninput" @bind:after="State.Touch" placeholder="例如 wanip" spellcheck="false" aria-invalid="@(Error("key", row) is not null)" aria-describedby="attribute-key-error" /><FieldError Id="attribute-key-error" Message="@Error("key", row)" /><small>小写字母开头，可含数字和下划线；用于公式引用。</small></label>
                    <label for="attribute-kind">属性类型<select id="attribute-kind" aria-label="属性类型" @bind="row.Visibility" @bind:after="State.Touch"><option value="@AttributeVisibility.Display">展示属性</option><option value="@AttributeVisibility.Virtual" disabled="@(row.Source == AttributeSource.Rules)">虚拟属性</option></select><small>@(row.Visibility == AttributeVisibility.Display ? "作为采集结果显示在设备页面。" : "仅参与计算，不单独上报。")</small></label>
                    <label for="attribute-source">获取方式<select id="attribute-source" aria-label="获取方式" value="@row.Source" @onchange="@(e => State.ChangeSource(row, Enum.Parse<AttributeSource>(e.Value!.ToString()!)))"><option value="@AttributeSource.Command">自定义命令</option><option value="@AttributeSource.Nvram">NVRAM 读取</option><option value="@AttributeSource.Uci">UCI 读取</option><option value="@AttributeSource.Expression">公式计算</option>@if (row.Visibility == AttributeVisibility.Display) { <option value="@AttributeSource.Rules">条件结果</option> }</select><FieldError Message="@Error("source", row)" /></label>
                </div>
            </section>

            @if (row.Source == AttributeSource.Rules)
            {
                <RulesEditor State="State" Row="row" />
            }
            else
            {
                <section class="editor-section">
                    <h3>数据源</h3>
                    <div class="field-grid">
                        @if (row.Source is AttributeSource.Command or AttributeSource.Expression)
                        {
                            <label class="full-width" for="attribute-input">@(row.Source == AttributeSource.Expression ? "计算公式" : "采集命令")<textarea id="attribute-input" class="code-input" aria-label="来源内容" rows="4" @bind="row.Input" @bind:event="oninput" @bind:after="State.Touch" placeholder="@(row.Source == AttributeSource.Expression ? "(total - free) / total * 100" : "uname -r")" spellcheck="false" aria-invalid="@(Error("input", row) is not null)" aria-describedby="attribute-input-error"></textarea><FieldError Id="attribute-input-error" Message="@Error("input", row)" /></label>
                        }
                        else
                        {
                            <label for="attribute-input">@(row.Source == AttributeSource.Nvram ? "NVRAM 键名" : "UCI 路径")<input id="attribute-input" class="code-input" aria-label="来源内容" @bind="row.Input" @bind:event="oninput" @bind:after="State.Touch" placeholder="@(row.Source == AttributeSource.Nvram ? "wan_ipaddr" : "system.@system[0].hostname")" spellcheck="false" aria-invalid="@(Error("input", row) is not null)" aria-describedby="attribute-input-error" /><FieldError Id="attribute-input-error" Message="@Error("input", row)" /><small>只读采集，使用固件的 get 操作。</small></label>
                        }
                        @if (row.Source == AttributeSource.Expression)
                        {
                            <div class="formula-tools full-width"><div class="operator-tools" aria-label="插入运算符">@foreach (var op in operators) { <button type="button" title="追加运算符" @onclick="@(() => Append(row, op))">@op.Trim()</button> }</div><label for="formula-reference" class="compact-reference">插入属性引用<select id="formula-reference" aria-label="插入属性引用" value="" @onchange="@(e => Append(row, e.Value?.ToString() ?? ""))"><option value="">选择属性…</option>@foreach (var reference in References(row)) { <option value="@reference.Key">@reference.Name · @reference.Key</option> }</select></label></div>
                            <p class="field-hint full-width">支持算术、比较、与或非和括号；布尔值 true / false 对应 1 / 0。</p>
                        }
                        else
                        {
                            <label for="attribute-sample" class="@(row.Source == AttributeSource.Command ? "full-width" : "")">模拟采集值<textarea id="attribute-sample" aria-label="模拟采集值" rows="2" @bind="row.Sample" @bind:event="oninput" @bind:after="State.Touch"></textarea><small>仅用于预览；实际值由探针在设备上读取。</small></label>
                        }
                    </div>
                </section>
                <section class="editor-section compact-section"><h3>显示规则</h3><p class="field-hint">@(row.Visibility == AttributeVisibility.Virtual ? "此属性用作计算输入，不直接显示。" : row.Source == AttributeSource.Expression ? "将公式结果显示为数值；逻辑运算输出 1 或 0。" : "显示采集来源返回的文本。需要按条件显示不同文本时，将获取方式改为“条件结果”。")</p></section>
            }

            <details class="editor-section advanced-section" open="@(Error("timeout", row) is not null)">
                <summary>高级设置</summary>
                @if (row.Visibility == AttributeVisibility.Display)
                {
                    <div class="field-grid"><label for="attribute-timeout">总采集超时（秒）<input id="attribute-timeout" aria-label="采集超时" type="number" min="1" max="30" step="1" @bind="row.Timeout" @bind:event="oninput" @bind:after="State.Touch" aria-invalid="@(Error("timeout", row) is not null)" aria-describedby="attribute-timeout-error" /><FieldError Id="attribute-timeout-error" Message="@Error("timeout", row)" /><small>1–30 秒，包含此展示属性的全部依赖采集。</small></label></div>
                }
                else { <p class="field-hint">虚拟属性由引用它的展示属性触发读取，使用对应展示属性的超时。</p> }
                <p class="field-hint">已有字段：<code>serial、model、firmware、hostname、kernel、libc</code>。必需身份字段不可覆盖。</p>
            </details>
        </fieldset>
    </div>
}

@code {
    [Parameter, EditorRequired] public EditorWorkspace State { get; set; } = default!;
    private static readonly string[] operators = [" + ", " - ", " * ", " / ", " && ", " || ", " !", "(", ")", " == ", " != ", " >= ", " <= "];
    private string? Error(string field, TemplateAttribute row) => State.FieldError(field, row.Id);
    private IEnumerable<TemplateAttribute> References(TemplateAttribute row) => State.Project.Attributes.Where(a => a.Id != row.Id && a.Key.Length > 0 && a.Source != AttributeSource.Rules);
    private void Append(TemplateAttribute row, string text) { row.Input += text; State.Touch(); }
}
