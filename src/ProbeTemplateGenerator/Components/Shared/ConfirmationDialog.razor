<div class="dialog-backdrop">
    <section class="confirmation-dialog" role="dialog" aria-modal="true" aria-labelledby="confirmation-title" aria-describedby="confirmation-message" @onkeydown="KeyDown">
        <h2 id="confirmation-title">@Title</h2>
        <p id="confirmation-message">@Message</p>
        <div class="dialog-actions"><button @ref="cancelButton" disabled="@Busy" @onclick="OnCancel">取消</button><FluentButton Appearance="Appearance.Accent" Class="@(Danger ? "danger-action" : "")" Disabled="@Busy" OnClick="OnConfirm">@(Busy ? "处理中…" : ActionText)</FluentButton></div>
    </section>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public string ActionText { get; set; } = "确认";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private ElementReference cancelButton;
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await cancelButton.FocusAsync(); }
    private Task KeyDown(KeyboardEventArgs args) => args.Key == "Escape" && !Busy ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
