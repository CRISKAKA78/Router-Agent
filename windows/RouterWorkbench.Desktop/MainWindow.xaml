<Window x:Class="RouterWorkbench.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RouterWorkbench.Desktop" Title="Router Workbench" Width="1480" Height="920" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen">
 <DockPanel SizeChanged="ShellSizeChanged" Background="{DynamicResource Surface}" TextElement.Foreground="{DynamicResource Text}">
  <Menu DockPanel.Dock="Top">
   <MenuItem Header="文件(_F)"><MenuItem Header="连接与设置" Click="SettingsClick" InputGestureText="Ctrl+O"/><MenuItem Header="断开连接" Click="DisconnectClick"/><Separator/><MenuItem Header="退出" Click="ExitClick"/></MenuItem>
   <MenuItem Header="视图(_V)"><MenuItem Header="设备工作区" Click="OverviewClick"/><MenuItem Header="文件传输" Click="FilesClick"/><Separator/><MenuItem Header="显示 / 隐藏输出" Click="ToggleOutputClick" InputGestureText="Ctrl+J"/><MenuItem Header="刷新" Click="RefreshClick" InputGestureText="F5"/><Separator/><MenuItem Header="浅色" Tag="Light" Click="ThemeClick"/><MenuItem Header="深色" Tag="Dark" Click="ThemeClick"/><MenuItem Header="跟随系统" Tag="Default" Click="ThemeClick"/></MenuItem>
   <MenuItem Header="设备(_D)"><MenuItem Header="远程维护" Click="MaintenanceClick"/><MenuItem Header="配置读写" Click="ConfigClick"/><MenuItem Header="完整设备信息" Click="DeviceInspectClick"/><MenuItem Header="断开设备…" Click="DeviceDisconnectClick"/></MenuItem>
   <MenuItem Header="设置(_S)"><MenuItem Header="连接与设置" Click="SettingsClick"/></MenuItem>
   <MenuItem Header="帮助(_H)"><MenuItem Header="快捷键与关于" Click="AboutClick"/></MenuItem>
  </Menu>
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,4">
   <DockPanel><TextBlock x:Name="ConnectionText" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource MutedText}"/><TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource MutedText}"/><TextBlock x:Name="SyncText" DockPanel.Dock="Right" Margin="15,0" Style="{StaticResource MutedText}"/><TextBlock x:Name="StatusText" Text="就绪 · 请连接服务器" TextTrimming="CharacterEllipsis"/></DockPanel>
  </Border>
  <Border x:Name="PendingBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,1" Padding="10,6">
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="核对后重试原请求…" Click="RetryClick"/><Button Content="放弃本地待定记录…" Click="AbandonClick"/></StackPanel><TextBlock x:Name="PendingText" TextWrapping="Wrap"/></DockPanel>
  </Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ExplorerColumn" Width="320" MinWidth="210"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*" MinWidth="640"/></Grid.ColumnDefinitions>
   <Grid Background="{DynamicResource Panel}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="30"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,0"><DockPanel LastChildFill="False"><TextBlock Text="设备资源管理器" FontWeight="SemiBold"/><TextBlock x:Name="DeviceCountText" DockPanel.Dock="Right" Style="{StaticResource MutedText}"/></DockPanel></Border>
    <StackPanel Grid.Row="1" Margin="8,7"><TextBox x:Name="DeviceSearch" local:ControlChrome.IsSearch="True" Tag="搜索设备 / ID  (Ctrl+F)" AutomationProperties.Name="搜索设备" ToolTip="按名称、型号或设备 ID 筛选 (Ctrl+F)" TextChanged="SearchChanged"/><CheckBox x:Name="OnlineOnly" Content="仅显示在线设备" Margin="0,7,0,0" Checked="SearchChanged" Unchecked="SearchChanged"/></StackPanel>
    <TabControl x:Name="ExplorerTabs" Grid.Row="2" SelectionChanged="ExplorerSelectionChanged">
     <TabItem Header="设备列表"><Grid>
      <local:DeviceList x:Name="DevicesGrid" Style="{StaticResource DeviceExplorerGrid}" AutomationProperties.Name="设备列表" SelectionChanged="DeviceSelectionChanged">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="序号" Width="46" CanUserSort="False" CanUserReorder="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(local:DeviceList.RowNumber)}" TextAlignment="Center" Foreground="{DynamicResource Muted}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="设备名" Width="*" SortMemberPath="DeviceName" ClipboardContentBinding="{Binding DeviceName}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <DockPanel><local:WorkbenchIcon Kind="device" Margin="0,0,5,0" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding DeviceName}" ToolTip="{Binding DeviceName}" TextTrimming="CharacterEllipsis"/></DockPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="设备ID" Binding="{Binding DeviceId}" SortMemberPath="DeviceId" Width="1.3*"/>
        <DataGridTemplateColumn Header="状态" Width="68" SortMemberPath="StatusText" ClipboardContentBinding="{Binding StatusText}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="5" Height="5" Margin="0,0,5,0" Style="{StaticResource DeviceStatusDot}"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Muted}"/></StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </local:DeviceList>
      <TextBlock x:Name="DevicesEmpty" Text="连接服务器后显示设备" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,48,8,8" IsHitTestVisible="False"/>
     </Grid></TabItem><TabItem x:Name="DiscoveryTab" Header="设备发现"/>
    </TabControl>
   </Grid>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="OutputSplitterRow" Height="0"/><RowDefinition x:Name="OutputRow" Height="0" MinHeight="0"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><local:DeviceSummary x:Name="Summary"/></Border>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Style="{StaticResource WorkbenchTabs}" SelectionChanged="PageChanged"/>
    <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="8,2"><DockPanel><Button DockPanel.Dock="Right" Content="清空活动" Click="ClearActivityClick" Style="{StaticResource ToolbarButton}" MinHeight="28" Padding="8,2"/><Button Click="ToggleOutputClick" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="展开或收起工作区活动" MinHeight="28" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock x:Name="OutputCaption" Text="工作区活动" FontWeight="SemiBold"/><TextBlock x:Name="OutputToggleText" Text="展开" Margin="12,0,0,0" Style="{StaticResource MutedText}"/></StackPanel></Button></DockPanel></Border>
    <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" DragCompleted="OutputResized"/>
    <DockPanel Grid.Row="4">
     <DataGrid x:Name="ActivityGrid" Style="{StaticResource OutputGrid}" RowHeight="NaN" HeadersVisibility="None" AutomationProperties.Name="工作区活动"><DataGrid.Columns><DataGridTextColumn Binding="{Binding Time}" Width="80"/><DataGridTextColumn Binding="{Binding Level}" Width="60"/><DataGridTextColumn Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid>
    </DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
