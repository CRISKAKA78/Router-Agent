+package relay
+
+import (
+	"bytes"
+	"net"
+	"sync"
+	"testing"
+)
+
+func TestPOCDatagramFrames(t *testing.T) {
+	pc := newPipeConn()
+	c := UDPTunServerConn(pc)
+	addr := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 1234}
+	for _, size := range []int{0, 1, 8192, 32000, 65000, 0, 19} {
+		payload := bytes.Repeat([]byte{byte(size)}, size)
+		if n, e := c.WriteTo(payload, addr); e != nil || n != size {
+			t.Fatalf("write %d %d %v", size, n, e)
+		}
+	}
+	for _, size := range []int{0, 1, 8192, 32000, 65000, 0, 19} {
+		b := make([]byte, 65535)
+		n, a, e := c.ReadFrom(b)
+		if e != nil || n != size || a.String() != addr.String() || !bytes.Equal(b[:n], bytes.Repeat([]byte{byte(size)}, size)) {
+			t.Fatalf("read %d %d %v %v", size, n, a, e)
+		}
+	}
+	c.WriteTo(bytes.Repeat([]byte{7}, 100), addr)
+	c.WriteTo([]byte("next"), addr)
+	b := make([]byte, 4)
+	if n, _, e := c.ReadFrom(b); n != 4 || e != nil {
+		t.Fatalf("truncate %d %v", n, e)
+	}
+	if n, _, e := c.ReadFrom(b); n != 4 || e != nil || string(b) != "next" {
+		t.Fatalf("next frame %d %v %q", n, e, b)
+	}
+	if _, e := c.WriteTo(make([]byte, 65536), addr); e == nil {
+		t.Fatal("oversize accepted")
+	}
+}
+func TestPOCConcurrentDatagramFrames(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	tx, rx := UDPTunServerConn(a), UDPTunServerConn(b)
+	var wg sync.WaitGroup
+	const workers = 8
+	const frames = 20
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			for j := 0; j < frames; j++ {
+				_, e := tx.WriteTo(bytes.Repeat([]byte{byte(i)}, 1024), &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 1000 + i})
+				if e != nil {
+					t.Error(e)
+					return
+				}
+			}
+		}(i)
+	}
+	for i := 0; i < workers*frames; i++ {
+		buf := make([]byte, 65535)
+		n, addr, e := rx.ReadFrom(buf)
+		if e != nil {
+			t.Fatal(e)
+		}
+		port := addr.(*net.UDPAddr).Port - 1000
+		if n != 1024 || !bytes.Equal(buf[:n], bytes.Repeat([]byte{byte(port)}, 1024)) {
+			t.Fatal("frame interleaved")
+		}
+	}
+	wg.Wait()
+}
