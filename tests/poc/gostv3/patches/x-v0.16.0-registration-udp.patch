+//go:build linux
+
+package serial
+
+import (
+	"fmt"
+	"golang.org/x/sys/unix"
+	"io"
+	"testing"
+	"time"
+)
+
+func pocPTY(t *testing.T) (int, string) {
+	t.Helper()
+	fd, e := unix.Open("/dev/ptmx", unix.O_RDWR|unix.O_NOCTTY|unix.O_NONBLOCK, 0)
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { unix.Close(fd) })
+	if e = unix.IoctlSetPointerInt(fd, unix.TIOCSPTLCK, 0); e != nil {
+		t.Fatal(e)
+	}
+	n, e := unix.IoctlGetInt(fd, unix.TIOCGPTN)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return fd, fmt.Sprintf("/dev/pts/%d", n)
+}
+func TestPOCSerialCloseUnblocksIdleRead(t *testing.T) {
+	master, path := pocPTY(t)
+	for i := 0; i < 3; i++ {
+		p, e := OpenPort(&Config{Name: path, Baud: 115200})
+		if e != nil {
+			t.Fatal(e)
+		}
+		if e = p.(*Port).Flush(); e != nil {
+			t.Fatal(e)
+		}
+		_, e = unix.Write(master, []byte{byte(i)})
+		if e != nil {
+			t.Fatal(e)
+		}
+		var b [1]byte
+		if n, e := p.Read(b[:]); n != 1 || e != nil || b[0] != byte(i) {
+			t.Fatalf("roundtrip %d %v", n, e)
+		}
+		read := make(chan error, 1)
+		go func() { var b [1]byte; _, e := p.Read(b[:]); read <- e }()
+		time.Sleep(30 * time.Millisecond)
+		closed := make(chan error, 1)
+		go func() { closed <- p.Close() }()
+		select {
+		case e := <-closed:
+			if e != nil {
+				t.Fatal(e)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("Close blocked behind UART read")
+		}
+		select {
+		case e := <-read:
+			if e == nil {
+				t.Fatal("read was not cancelled")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("old UART reader retained")
+		}
+	}
+}
+func TestPOCSerialReadTimeout(t *testing.T) {
+	master, path := pocPTY(t)
+	p, e := OpenPort(&Config{Name: path, Baud: 9600, ReadTimeout: 100 * time.Millisecond})
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer p.Close()
+	var b [1]byte
+	start := time.Now()
+	n, e := p.Read(b[:])
+	if n != 0 || e != io.EOF || time.Since(start) < 80*time.Millisecond {
+		t.Fatalf("timeout %d %v", n, e)
+	}
+	if _, e = unix.Write(master, []byte("x")); e != nil {
+		t.Fatal(e)
+	}
+	if n, e = p.Read(b[:]); n != 1 || e != nil || b[0] != 'x' {
+		t.Fatalf("after timeout %d %v", n, e)
+	}
+}
