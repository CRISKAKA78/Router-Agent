+package net
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"testing"
+)
+
+type pocPackets struct {
+	packets [][]byte
+	written [][]byte
+}
+
+func (p *pocPackets) Read(b []byte) (int, error) {
+	if len(p.packets) == 0 {
+		return 0, io.EOF
+	}
+	v := p.packets[0]
+	p.packets = p.packets[1:]
+	return copy(b, v), nil
+}
+func (p *pocPackets) Write(b []byte) (int, error) {
+	p.written = append(p.written, append([]byte(nil), b...))
+	return len(b), nil
+}
+func (p *pocPackets) Close() error { return nil }
+func TestPOCPipeDatagramBuffer(t *testing.T) {
+	var opts pipeOptions
+	WithDatagramBuffer()(&opts)
+	src := &pocPackets{packets: [][]byte{nil, bytes.Repeat([]byte{9}, 65000), {1}}}
+	dst := &pocPackets{}
+	if e := pipeHalf(context.Background(), src, dst, 0, opts.bufferSize); e != nil {
+		t.Fatal(e)
+	}
+	if len(dst.written) != 3 || len(dst.written[0]) != 0 || len(dst.written[1]) != 65000 || !bytes.Equal(dst.written[2], []byte{1}) {
+		t.Fatal("datagram truncated or dropped")
+	}
+}
