+package wrapper
+
+import (
+	limiter "github.com/go-gost/core/limiter/conn"
+	xconn "github.com/go-gost/x/limiter/conn"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestPOCListenerSurvivesRejection(t *testing.T) {
+	raw, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer raw.Close()
+	cl := &connLimiter{lims: map[string]limiter.Limiter{"127.0.0.1": xconn.NewLimiter(1)}}
+	ln := WrapListener(cl, raw)
+	first, e := net.Dial("tcp", raw.Addr().String())
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer first.Close()
+	owned, e := ln.Accept()
+	if e != nil {
+		t.Fatal(e)
+	}
+	accepted := make(chan net.Conn, 1)
+	errs := make(chan error, 1)
+	go func() {
+		c, e := ln.Accept()
+		if e != nil {
+			errs <- e
+		} else {
+			accepted <- c
+		}
+	}()
+	second, e := net.Dial("tcp", raw.Addr().String())
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer second.Close()
+	second.SetReadDeadline(time.Now().Add(time.Second))
+	var b [1]byte
+	if _, e = second.Read(b[:]); e == nil {
+		t.Fatal("second not closed")
+	} else if ne, ok := e.(net.Error); ok && ne.Timeout() {
+		t.Fatal("second not rejected")
+	}
+	owned.Close()
+	third, e := net.Dial("tcp", raw.Addr().String())
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer third.Close()
+	select {
+	case c := <-accepted:
+		c.Close()
+	case e := <-errs:
+		t.Fatalf("listener stopped: %v", e)
+	case <-time.After(time.Second):
+		t.Fatal("new owner not accepted")
+	}
+}
